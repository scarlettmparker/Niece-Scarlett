scalar JSON

type PagedAccounts {
  items: [Account!]!
  pageInfo: PageInfo!
}

type Account {
  id: String!
  username: String!
  personId: ID!
  status: AccountStatus!
  provider: String
  remoteUsers: [RemoteUser!]
  createdAt: DateTime
  updatedAt: DateTime
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

type GaiaQueries {
  propertySet(ownerKey: String!, name: String!, entry: String): JSON
  myRoles: [String!]!
  account(id: ID!): Account
  accounts(pagination: PaginationInput): PagedAccounts!
  effectivePermissions(remoteUserType: RemoteUserType!, remoteUserId: String!): [String!]!
  accessibleCommandIntents(
    remoteUserType: RemoteUserType!
    remoteUserId: String!
    ownerKey: String!
    propertySet: String!
  ): [PropertySetEntry!]!
}

enum EntryStatus {
  ACTIVE
  ARCHIVED
}

type PropertySetEntry {
  id: String!
  ownerKey: String!
  propertySet: String!
  entryName: String!
  values: JSON!
  configurable: Boolean!
  status: EntryStatus!
  createdAt: DateTime
  updatedAt: DateTime
}

input LoginInput {
  username: String!
  password: String!
}

type AuthResult {
  token: String!
  accountId: ID!
  personId: ID!
}

type SuspendAccountResponse {
  message: String!
  account: Account!
}

type UnsuspendAccountResponse {
  message: String!
  account: Account!
}

type DeactivateAccountResponse {
  message: String!
}

type RequestAccountReactivationResponse {
  message: String!
}

type ConfirmAccountReactivationResponse {
  message: String!
}

type GaiaMutations {
  login(input: LoginInput!): AuthResult
  suspendAccount(id: ID!): SuspendAccountResponse!
  unsuspendAccount(id: ID!): UnsuspendAccountResponse!
  deactivateAccount: DeactivateAccountResponse!
  requestAccountReactivation(email: String!, provider: String!): RequestAccountReactivationResponse!
  confirmAccountReactivation(token: String!): ConfirmAccountReactivationResponse!
}

extend type Query {
  gaiaQueries: GaiaQueries!
}

extend type Mutation {
  gaiaMutations: GaiaMutations!
}
